datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  ADMIN
  GODOWN_MANAGER
  QUALITY_INSPECTOR
  DISPATCH_OFFICER
}

enum QualityGrade {
  GRADE_A
  GRADE_B
  QUARANTINE
  DAMAGED
}

enum BatchStatus {
  ACTIVE
  EXHAUSTED
  QUARANTINE
  FUMIGATION_LOCKOUT
}

enum ChallanStatus {
  PENDING
  DISPATCHED
  DELIVERED
  CANCELLED
}

enum MovementType {
  RECEIPT
  DISPATCH
  ADJUSTMENT
  REVERSAL
}

model User {
  id           String        @id @default(uuid())
  email        String        @unique
  passwordHash String
  name         String
  role         Role          @default(GODOWN_MANAGER)
  godownId     String?
  godown       Godown?       @relation(fields: [godownId], references: [id])
  receipts     StockReceipt[]
  challans     DeliveryChallan[]
  movements    StockMovement[]
  auditLogs    AuditLog[]
  fifoApprovals FifoException[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@index([email])
  @@index([role])
}

model Godown {
  id          String         @id @default(uuid())
  code        String         @unique
  name        String
  district    String
  state       String
  capacityMt  Float
  active      Boolean        @default(true)
  users       User[]
  receipts    StockReceipt[]
  batches     InventoryBatch[]
  challans    DeliveryChallan[]
  movements   StockMovement[]
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@index([code])
}

model Commodity {
  id                   String           @id @default(uuid())
  code                 String           @unique
  name                 String
  category             String
  standardBagWeightKg  Int              @default(50)
  defaultShelfLifeDays Int              @default(365)
  receipts             StockReceipt[]
  batches              InventoryBatch[]
  challans             DeliveryChallan[]
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt

  @@index([code])
}

model Supplier {
  id            String         @id @default(uuid())
  code          String         @unique
  name          String
  state         String
  contactPerson String?
  phone         String?
  email         String?
  receipts      StockReceipt[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@index([code])
}

model FairPriceShop {
  id                     String            @id @default(uuid())
  code                   String            @unique
  name                   String
  dealerName             String
  district               String
  taluka                 String
  beneficiaryCardsCount  Int               @default(0)
  contactPhone           String
  activeQuotaRemainingKg Int               @default(0)
  challans               DeliveryChallan[]
  createdAt              DateTime          @default(now())
  updatedAt              DateTime          @updatedAt

  @@index([code])
  @@index([district])
}

model StockReceipt {
  id             String          @id @default(uuid())
  receiptNumber  String          @unique
  godownId       String
  godown         Godown          @relation(fields: [godownId], references: [id])
  supplierId     String
  supplier       Supplier        @relation(fields: [supplierId], references: [id])
  commodityId    String
  commodity      Commodity       @relation(fields: [commodityId], references: [id])
  variety        String
  receiptDate    DateTime
  expiryDate     DateTime
  vehicleNumber  String?
  labReportNo    String?
  moisturePercent Float?
  stackLocation  String?
  bayId          String?
  quantityKg     Int
  bagCount       Int
  qualityGrade   QualityGrade    @default(GRADE_A)
  createdById    String
  createdBy      User            @relation(fields: [createdById], references: [id])
  remarks        String?
  batch          InventoryBatch?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@index([receiptNumber])
  @@index([godownId])
  @@index([commodityId])
  @@index([supplierId])
  @@index([receiptDate])
}

model InventoryBatch {
  id                  String              @id @default(uuid())
  batchNumber         String              @unique
  godownId            String
  godown              Godown              @relation(fields: [godownId], references: [id])
  receiptId           String              @unique
  receipt             StockReceipt        @relation(fields: [receiptId], references: [id])
  commodityId         String
  commodity           Commodity           @relation(fields: [commodityId], references: [id])
  variety             String
  initialQuantityKg   Int
  remainingQuantityKg Int
  bagCount            Int
  bagWeightKg         Int                 @default(50)
  stackLocation       String
  bayId               String
  moisturePercent     Float
  qualityGrade        QualityGrade        @default(GRADE_A)
  status              BatchStatus         @default(ACTIVE)
  receiptDate         DateTime
  expiryDate          DateTime
  fumigationDueDate   DateTime?
  lastFumigationDate  DateTime?
  quarantineReason    String?
  allocations         ChallanAllocation[]
  movements           StockMovement[]
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt

  @@index([batchNumber])
  @@index([godownId, commodityId])
  @@index([status])
  @@index([receiptDate])
}

model DeliveryChallan {
  id             String              @id @default(uuid())
  challanNumber  String              @unique
  godownId       String
  godown         Godown              @relation(fields: [godownId], references: [id])
  fpsId          String
  fps            FairPriceShop       @relation(fields: [fpsId], references: [id])
  commodityId    String
  commodity      Commodity           @relation(fields: [commodityId], references: [id])
  totalQuantityKg Int
  totalBags      Int
  vehicleNumber  String
  driverName     String
  driverPhone    String
  status         ChallanStatus       @default(DISPATCHED)
  dispatchDate   DateTime            @default(now())
  createdById    String
  createdBy      User                @relation(fields: [createdById], references: [id])
  remarks        String?
  allocations    ChallanAllocation[]
  fifoExceptions FifoException[]
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  @@index([challanNumber])
  @@index([godownId])
  @@index([fpsId])
  @@index([commodityId])
  @@index([dispatchDate])
}

model ChallanAllocation {
  id          String          @id @default(uuid())
  challanId   String
  challan     DeliveryChallan @relation(fields: [challanId], references: [id], onDelete: Cascade)
  batchId     String
  batch       InventoryBatch  @relation(fields: [batchId], references: [id])
  quantityKg  Int
  bagCount    Int
  priorityRank Int            @default(1)
  createdAt   DateTime        @default(now())

  @@index([challanId])
  @@index([batchId])
}

model StockMovement {
  id             String         @id @default(uuid())
  batchId        String
  batch          InventoryBatch @relation(fields: [batchId], references: [id])
  godownId       String
  godown         Godown         @relation(fields: [godownId], references: [id])
  movementType   MovementType
  quantityKg     Int
  balanceAfterKg Int
  referenceType  String
  referenceId    String
  reason         String?
  performedById  String
  performedBy    User           @relation(fields: [performedById], references: [id])
  createdAt      DateTime       @default(now())

  @@index([batchId])
  @@index([godownId])
  @@index([referenceId])
  @@index([movementType])
  @@index([createdAt])
}

model AuditLog {
  id            String   @id @default(uuid())
  action        String
  entity        String
  entityId      String
  payloadJson   String?
  performedById String?
  performedBy   User?    @relation(fields: [performedById], references: [id])
  timestamp     DateTime @default(now())

  @@index([entity, entityId])
  @@index([performedById])
  @@index([timestamp])
}

model FifoException {
  id               String           @id @default(uuid())
  challanId        String?
  challan          DeliveryChallan? @relation(fields: [challanId], references: [id])
  requestedBatchId String
  bypassedBatchId  String
  reason           String
  approvedById     String
  approvedBy       User             @relation(fields: [approvedById], references: [id])
  createdAt        DateTime         @default(now())

  @@index([challanId])
  @@index([approvedById])
}
