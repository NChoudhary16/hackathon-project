# ============================================================
# Root-level .gitignore for the hackathon monorepo
# ============================================================

# OS
.DS_Store
Thumbs.db

# Editor / IDE
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln

# AI agent config (Antigravity, Claude, etc.)
/frontend/.agents/
/frontend/.claude/
/frontend/.next

# Environment files — never commit secrets
/backend/.env
.env.*
!.env.example

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Misc
*.pem
